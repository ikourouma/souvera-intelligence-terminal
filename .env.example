# Souvera Intelligence Terminal — Environment Variables Template
# Copy this to .env.local and fill in your values.

# ===========================================
# SUPABASE (Dedicated Souvera Project)
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===========================================
# DATA SOURCE API KEYS
# ===========================================
# World Bank, IMF, OECD, REST Countries, GDELT are public (no key needed)
OPEN_EXCHANGE_RATES_API_KEY=
NEWSAPI_KEY=
UN_COMTRADE_API_KEY=
AFDB_API_KEY=
TRADING_ECONOMICS_API_KEY=
IEA_API_TOKEN=

# ===========================================
# APP CONFIG
# ===========================================
APP_ENV=dev
