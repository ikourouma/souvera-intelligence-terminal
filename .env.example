# Souvera Intelligence Terminal — Environment Variables Template
# Copy this to .env.local and fill in your values.

# ===========================================
# SUPABASE (Dedicated Souvera Project)
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===========================================
# DATA SOURCE API KEYS
# ===========================================
# World Bank, IMF, OECD, REST Countries, GDELT are public (no key needed)
OPEN_EXCHANGE_RATES_API_KEY=
NEWSAPI_KEY=
UN_COMTRADE_API_KEY=
AFDB_API_KEY=
TRADING_ECONOMICS_API_KEY=
IEA_API_TOKEN=

# ===========================================
# AI / LLM (api-gateway + ingestion workers)
# ===========================================
# Google Gemini — trade intelligence narratives, curated news drafts, report assist
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# ===========================================
# APP CONFIG
# ===========================================
APP_ENV=dev

# ===========================================
# REPORTS (api-gateway)
# ===========================================
# Country Profile (country_profile_template) — required in production; auto-on when APP_ENV=dev
REPORTS_V2_ENABLED=true
# Foundation phase: pause PDF generation until Phase 3 (see docs/platform/foundation-assessment-2026.md)
# REPORTS_GENERATION_PAUSED=false
# REPORTS_COUNTRY_PROFILE_ENABLED=true
# REPORTS_SHOW_TEMPLATE_STAMP=true
# REPORTS_BUILD_ID=local-qa
